# Entity: competition

main: kit: entity: competition: {

  alias: field: {}

  fields: [
    {
      name: "area"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "code"
      req: false
      type: "`$STRING`"
    }
    {
      name: "current_season"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "emblem"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "last_updated"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "number_of_available_season"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "plan"
      req: false
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "competition"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "AFR,UEFA"
                kind: "query"
                name: "area"
                orig: "area"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "plan"
                orig: "plan"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/competitions"
          parts: [
            "competitions"
          ]
          select: {
            exist: [
              "area"
              "plan"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 2006
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/competitions/{id}"
          parts: [
            "competitions"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
