  name: "competition"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "AFR,UEFA"
                kind: "query"
                name: "area"
                orig: "area"
                reqd: false
                type: "`$STRING`"
