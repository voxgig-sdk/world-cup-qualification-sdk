# Entity: competition

main: kit: entity: competition: {

  alias: field: {}

  fields: [
    {
      name: "area"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "code"
      req: false
      short: "Short code for the competition"
      type: "`$STRING`"
    }
    {
      name: "currentSeason"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "emblem"
      req: false
      short: "URL to competition emblem/logo"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the competition"
      type: "`$INTEGER`"
    }
    {
      name: "lastUpdated"
      req: false
      short: "Last update timestamp"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the competition"
      type: "`$STRING`"
    }
    {
      name: "numberOfAvailableSeasons"
      req: false
      short: "Number of seasons available in the API"
      type: "`$INTEGER`"
    }
    {
      name: "plan"
      req: false
      short: "API access tier required"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Type of competition"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "competition"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "AFR,UEFA"
                kind: "query"
                name: "area"
                orig: "area"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "plan"
                orig: "plan"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/competitions"
          parts: [
            "competitions"
          ]
          select: {
            exist: [
              "area"
              "plan"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 2006
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/competitions/{id}"
          parts: [
            "competitions"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
